+// Long recordings hold their concurrency slot while alive. Crashes release it
+// after the short renewable lease, rather than after a fixed recording limit.
+func (s *Server) renewLease(ctx context.Context, cancel context.CancelFunc, j *Job) {
+	tick := time.NewTicker(30 * time.Second)
+	defer tick.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-tick.C:
+			qctx, done := context.WithTimeout(ctx, 5*time.Second)
+			_, err := s.db.ExecContext(qctx, `UPDATE voice_jobs SET deadline_at=now()+interval '90 seconds' WHERE id=$1 AND state='processing'`, j.ID)
+			done()
+			if err != nil {
+				cancel()
+				return
+			}
+		}
+	}
+}
