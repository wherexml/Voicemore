+package main
+
+import (
+	"encoding/binary"
+	"math"
+)
+
+// pcmGain is a causal, per-stream peak envelope. It boosts quiet PCM without
+// buffering, clipping or modifying the original recording/idempotency bytes.
+// Release uses samples, so WebSocket packet boundaries do not change output.
+type pcmGain struct{ peak float64 }
+
+func (g *pcmGain) apply(pcm []byte) []byte {
+	out := make([]byte, len(pcm))
+	if g.peak == 0 {
+		g.peak = 1750
+	}
+	const release = 0.9999687504882762 // exp(-1/(16000*2 seconds))
+	for i := 0; i+1 < len(pcm); i += 2 {
+		x := float64(int16(binary.LittleEndian.Uint16(pcm[i:])))
+		g.peak = math.Max(math.Abs(x), g.peak*release)
+		gain := math.Max(1, math.Min(16, 28000/math.Max(1, g.peak)))
+		y := int16(math.Round(x * gain))
+		binary.LittleEndian.PutUint16(out[i:], uint16(y))
+	}
+	return out
+}
