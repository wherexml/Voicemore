+++ b/quality_acceptance.go
@@ -0,0 +1,47 @@
+//go:build voicebenchmark
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// Compiled only for the isolated loopback acceptance service.
+func init() {
+	acceptanceRoutes = func(mux *http.ServeMux, s *Server) {
+		mux.HandleFunc("POST /acceptance/cleanup", func(w http.ResponseWriter, r *http.Request) {
+			if !strings.Contains(s.cfg.PromptFile, "acceptance-quality") {
+				sendError(w, problem(403, "ACCEPTANCE_ONLY"))
+				return
+			}
+			if _, e := s.auth(r); e != nil {
+				sendError(w, e)
+				return
+			}
+			var in struct {
+				Raw     string       `json:"raw"`
+				Prompt  string       `json:"prompt"`
+				Options *TextOptions `json:"options"`
+			}
+			if json.NewDecoder(http.MaxBytesReader(w, r.Body, 256<<10)).Decode(&in) != nil || !in.Options.valid() {
+				sendError(w, problem(400, "INVALID_INPUT"))
+				return
+			}
+			copy := *s
+			copy.prompt = in.Prompt
+			start := time.Now()
+			ctx, cancel := context.WithTimeout(r.Context(), 45*time.Second)
+			defer cancel()
+			text, usage, e := copy.cleanup(ctx, in.Raw, in.Options)
+			if e != nil {
+				sendError(w, e)
+				return
+			}
+			json.NewEncoder(w).Encode(map[string]any{"text": text, "usage": usage, "ms": time.Since(start).Milliseconds(), "prompt_sha256": hash([]byte(copy.prompt)), "scope": "real cleanup only; no audio, wallet charge or insertion"})
+		})
+	}
+}
